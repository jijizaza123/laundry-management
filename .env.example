# 复制成 .env 后填入自己的值；.env 已在 .gitignore 里
AGNES_API_KEY=your_key_here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash

# 可选：Agent 行为微调
# 单次模型调用超时（秒），失败会再重试一次。这条链路冷启动实测 15~70 秒都有
AGENT_TIMEOUT=90
# 最多几轮「调工具 → 再问模型」，超了就走兜底话术
AGENT_MAX_ROUNDS=4
# 带多少条历史对话进上下文
AGENT_HISTORY_TURNS=6
# 图引擎：loop=手写循环（默认，零依赖）；langgraph=换 LangGraph 编排（需要 pip install langgraph）
AGENT_ENGINE=loop

# 运行环境：dev / production。production 必须配置 LAUNDRY_SECRET_KEY，否则拒绝启动
LAUNDRY_ENV=dev
# 员工注册邀请码：留空=关闭公开注册（只能管理员在后台建号）
LAUNDRY_STAFF_INVITE_CODE=laundry-2026
# 生产环境请换成一串足够长的随机字符
# LAUNDRY_SECRET_KEY=change-me-to-a-long-random-string
